<%- include('partials/header', { title: 'News & Updates' }) %>

<!-- News Hero -->
<section class="about-hero">
  <div class="container">
    <span class="hero-badge" style="background: rgba(255,194,14,0.15); border-color: var(--primary-yellow); color: var(--primary-yellow);">Fleet &amp; Service Bulletins</span>
    <h1 style="font-size: 2.8rem; font-weight: 900; margin-bottom: 1rem;">News &amp; Route Updates</h1>
    <p style="font-size: 1.15rem; max-width: 680px; margin: 0 auto; color: var(--slate-200);">
      Stay informed with route expansions, vehicle safety upgrades, driver certifications, and seasonal notices.
    </p>
  </div>
</section>

<!-- News Cards Listing -->
<section class="section section-bg-slate">
  <div class="container">
    <div class="news-grid">
      <% if (news && news.length > 0) { %>
        <% news.forEach(item => { %>
          <article class="news-card" id="news-<%= item.id %>">
            <div class="news-card-thumb">
              <img src="<%= item.image_url || '/images/news-fleet.svg' %>" alt="<%= item.title %>" loading="lazy">
            </div>
            <div class="news-card-body">
              <div class="news-card-date">
                <svg style="width:14px;height:14px;fill:currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                <%= item.date %>
              </div>
              <h2 class="news-card-title"><%= item.title %></h2>
              <p class="news-card-text" style="color: var(--slate-600); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
                <%= item.content %>
              </p>
              <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--slate-100); display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary-navy); background: var(--primary-yellow-light); padding: 3px 8px; border-radius: var(--radius-sm);">
                  Verified Announcement
                </span>
                <a href="/contact" style="font-size: 0.85rem; font-weight: 700; color: #B45309;">
                  Questions? Contact Us &rarr;
                </a>
              </div>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; background: var(--white); border-radius: var(--radius-lg); border: 1px solid var(--slate-200);">
          <h3 style="color: var(--primary-navy); margin-bottom: 0.5rem;">No Announcements Currently Posted</h3>
          <p style="color: var(--slate-500);">Please check back soon for our latest service notifications.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Call to action -->
<section class="cta-banner">
  <div class="container cta-inner">
    <div class="cta-text">
      <h2 class="cta-title">Need a custom route for your school?</h2>
      <p class="cta-desc">
        We frequently open new community van loops when 4 or more families register along the same neighborhood corridor.
      </p>
    </div>
    <div class="cta-actions">
      <a href="/contact" class="btn btn-primary">Submit Route Inquiry</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
