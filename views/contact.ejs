<%- include('partials/header', { title: 'Contact Us' }) %>

<!-- Contact Hero -->
<section class="about-hero">
  <div class="container">
    <span class="hero-badge" style="background: rgba(255,194,14,0.15); border-color: var(--primary-yellow); color: var(--primary-yellow);">We're Here To Help</span>
    <h1 style="font-size: 2.8rem; font-weight: 900; margin-bottom: 1rem;">Contact &amp; Route Inquiries</h1>
    <p style="font-size: 1.15rem; max-width: 680px; margin: 0 auto; color: var(--slate-200);">
      Have questions about pickup timings, fees, or district routes? Get in touch with our friendly dispatch team.
    </p>
  </div>
</section>

<!-- Contact Content Grid -->
<section class="section section-bg-slate">
  <div class="container">
    <div class="contact-layout">
      <!-- Col 1: Contact Information Cards -->
      <div class="contact-info-card">
        <h2 class="contact-info-title">Dispatch Information</h2>
        <p style="color: var(--slate-300); margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.6;">
          Our routing coordinators and safety managers are on duty during all morning and afternoon student transit windows.
        </p>

        <div class="contact-info-items">
          <!-- Item 1: Phone -->
          <div class="contact-detail-row">
            <div class="contact-icon-bubble">
              <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </div>
            <div class="contact-detail-content">
              <h4>Direct Telephone</h4>
              <p><a href="tel:+15553928267" style="color:var(--primary-yellow);">(555) 392-8267</a></p>
              <span style="font-size: 0.8rem; color: var(--slate-400);">Mon-Fri: 6:00 AM - 6:30 PM</span>
            </div>
          </div>

          <!-- Item 2: Email -->
          <div class="contact-detail-row">
            <div class="contact-icon-bubble">
              <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </div>
            <div class="contact-detail-content">
              <h4>Electronic Mail</h4>
              <p><a href="mailto:info@saferideschoolvans.com" style="color:var(--white);">info@saferideschoolvans.com</a></p>
              <span style="font-size: 0.8rem; color: var(--slate-400);">Typical response under 2 hours</span>
            </div>
          </div>

          <!-- Item 3: Address -->
          <div class="contact-detail-row">
            <div class="contact-icon-bubble">
              <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
            <div class="contact-detail-content">
              <h4>Headquarters &amp; Dispatch Fleet Yard</h4>
              <p>428 Maple Ridge Ave, Suite 100<br>Metro City, MC 90210</p>
            </div>
          </div>

          <!-- Item 4: Operating Hours -->
          <div class="contact-detail-row">
            <div class="contact-icon-bubble">
              <svg style="width:20px;height:20px;fill:currentColor" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </div>
            <div class="contact-detail-content">
              <h4>Working Hours</h4>
              <p>Monday &ndash; Friday: 6:00 AM &ndash; 6:30 PM</p>
              <span style="font-size: 0.8rem; color: var(--slate-400);">Saturday (Charter Only): 8:00 AM &ndash; 1:00 PM</span>
            </div>
          </div>
        </div>

        <div style="background: rgba(255,255,255,0.06); padding: 1.25rem; border-radius: var(--radius-md); border-left: 3px solid var(--primary-yellow); font-size: 0.88rem; color: var(--slate-300);">
          <strong>Emergency Dispatch:</strong> For existing enrolled families needing urgent route assistance during active van hours, your driver's direct hotline is also accessible inside the SafeRide Guardian mobile portal.
        </div>
      </div>

      <!-- Col 2: Interactive Contact Form -->
      <div class="contact-form-box">
        <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 0.5rem;">Send Us a Message</h2>
        <p style="color: var(--slate-600); margin-bottom: 2rem;">
          Fill out the form below and our route coordinator will reach out promptly with schedule availability and exact pricing.
        </p>

        <!-- Feedback Alert box (managed via AJAX) -->
        <div id="contactAlert" style="display: none;" role="alert"></div>

        <form id="contactForm" method="POST" action="/api/contact">
          <div class="form-group">
            <label for="name" class="form-label">Full Name *</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Sarah Jenkins" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
            <div class="form-group">
              <label for="phone" class="form-label">Phone Number *</label>
              <input type="tel" id="phone" name="phone" class="form-control" placeholder="e.g. (555) 123-4567" required>
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email Address *</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="e.g. sarah@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Child's School, Neighborhood / Message *</label>
            <textarea id="message" name="message" class="form-control" rows="5" placeholder="Tell us your pickup address, school name, child's grade, and any special timing requirements..." required></textarea>
          </div>

          <button type="submit" id="contactSubmitBtn" class="btn btn-primary" style="width: 100%; padding: 0.9rem; font-size: 1.05rem;">
            Send Message &amp; Request Info
          </button>
        </form>
      </div>
    </div>

    <!-- Embedded Google Map Placeholder -->
    <div class="map-container">
      <iframe 
        title="සමස්ත ලංකා පාසල් ළමුන් ප්‍රවාහන සංගමය Service Map"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d105621.57946959244!2d-118.42395695000001!3d34.02047895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c75ddc27da13%3A0xe22fdf6f254608f4!2sLos%20Angeles%2C%20CA!5e0!3m2!1sen!2sus!4v1715000000000!5m2!1sen!2sus"
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
      <div style="position: absolute; bottom: 15px; left: 15px; background: rgba(11, 31, 58, 0.92); color: #fff; padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; border: 1px solid var(--primary-yellow); pointer-events: none;">
        📍 සමස්ත ලංකා පාසල් ළමුන් ප්‍රවාහන සංගමය Service Zone
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
