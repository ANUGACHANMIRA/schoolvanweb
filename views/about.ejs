<%- include('partials/header', { title: 'About Us' }) %>

<!-- About Hero -->
<section class="about-hero">
  <div class="container">
    <span class="hero-badge" style="background: rgba(255,194,14,0.15); border-color: var(--primary-yellow); color: var(--primary-yellow);">Dedicated To Student Safety</span>
    <h1 style="font-size: 2.5rem; font-weight: 900; margin-bottom: 1rem;">සමස්ත ලංකා පාසල් ළමුන් ප්‍රවාහන සංගමය</h1>
    <p style="font-size: 1.15rem; max-width: 680px; margin: 0 auto; color: var(--slate-200);">
      Setting the standard for modern, technology-enabled, and parent-friendly school transportation since 2018.
    </p>
  </div>
</section>

<!-- Company Story & Mission -->
<section class="section section-bg-white">
  <div class="container">
    <div class="about-grid">
      <div>
        <span class="section-subtitle">Our Heritage &amp; Journey</span>
        <h2 class="section-title">Founded by Parents, Built For Families</h2>
        <p style="color:var(--slate-600); margin-bottom: 1.25rem;">
          සමස්ත ලංකා පාසල් ළමුන් ප්‍රවාහන සංගමය was born out of a simple observation: working parents need school transportation they can genuinely rely on, with the same safety standards and loving attentiveness they provide themselves.
        </p>
        <p style="color:var(--slate-600); margin-bottom: 1.5rem;">
          Starting with just two vans and a handful of neighborhood routes, we have grown into the region's most reputable private school transportation provider. Today, our fleet serves over 30 schools across 4 major districts, moving hundreds of students safely each morning and evening.
        </p>
        
        <div class="stat-pills">
          <div class="stat-pill">
            <div class="stat-num">500,000+</div>
            <div class="stat-label">Safe Student Miles Driven</div>
          </div>
          <div class="stat-pill">
            <div class="stat-num">99.4%</div>
            <div class="stat-label">On-Time Arrival Rate</div>
          </div>
          <div class="stat-pill">
            <div class="stat-num">30+</div>
            <div class="stat-label">Partner Schools</div>
          </div>
          <div class="stat-pill">
            <div class="stat-num">100%</div>
            <div class="stat-label">Vetted Drivers &amp; Staff</div>
          </div>
        </div>
      </div>

      <div>
        <div style="background: var(--slate-900); border-radius: var(--radius-lg); padding: 2.5rem; color: var(--white); box-shadow: var(--shadow-xl); border: 2px solid var(--primary-yellow);">
          <span style="color: var(--primary-yellow); font-weight: 800; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem;">Our Core Mission</span>
          <h3 style="font-size: 1.8rem; font-weight: 900; margin: 0.75rem 0 1.25rem 0; line-height: 1.2;">
            Zero-Compromise Safety &amp; Absolute Peace of Mind
          </h3>
          <p style="color: var(--slate-300); margin-bottom: 1.5rem; line-height: 1.7;">
            Our mission is to eliminate parent anxiety during the school commute by pairing compassionate, extensively vetted drivers with cutting-edge vehicle telemetry, ensuring every child starts and ends their school day with confidence and a smile.
          </p>
          <hr style="border:0; border-top: 1px solid rgba(255,255,255,0.15); margin-bottom: 1.5rem;">
          <h4 style="color: var(--primary-yellow); margin-bottom: 0.75rem;">Our Values:</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.95rem; color: var(--slate-200);">
            <li>&#10003; <strong>Unwavering Safety:</strong> Every decision starts and ends with student protection.</li>
            <li>&#10003; <strong>Absolute Punctuality:</strong> Respecting families' and educators' schedules.</li>
            <li>&#10003; <strong>Full Transparency:</strong> Real-time GPS coordinates visible to parents always.</li>
            <li>&#10003; <strong>Genuine Warmth:</strong> Drivers who know your child by name and greet them kindly.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Safety Protocols & Measures -->
<section class="section section-bg-slate" id="safety">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Zero-Compromise Standards</span>
      <h2 class="section-title">Our Multi-Layered Safety Measures</h2>
      <p class="section-desc">
        We exceed standard federal and state transit regulations with our proprietary 4-Point Safety Protocol.
      </p>
    </div>

    <div class="feature-grid">
      <!-- 1 -->
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
        </div>
        <h3 class="feature-card-title">Daily 20-Point Van Inspections</h3>
        <p class="feature-card-desc">
          Before taking the road each morning, every driver performs an electronic checklist inspecting tires, brakes, lights, emergency door releases, and communication hardware.
        </p>
      </div>

      <!-- 2 -->
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
        </div>
        <h3 class="feature-card-title">Driver Background &amp; Vetting</h3>
        <p class="feature-card-desc">
          Federal FBI fingerprint background clearance, 10-year clean driving record, 5-panel random drug screenings, and verified professional childcare references.
        </p>
      </div>

      <!-- 3 -->
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
        </div>
        <h3 class="feature-card-title">First Aid &amp; Pediatric CPR</h3>
        <p class="feature-card-desc">
          Every driver is certified by the American Red Cross in pediatric CPR and first aid. All vans carry pediatric defibrillators (AEDs) and trauma-rated medical kits.
        </p>
      </div>

      <!-- 4 -->
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
        </div>
        <h3 class="feature-card-title">Dual Dashcams &amp; SOS</h3>
        <p class="feature-card-desc">
          Interior cabin audio/video surveillance and forward-facing road cameras protect students and verify driver conduct. Instant one-touch SOS dispatch alerts are always armed.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Fleet Information -->
<section class="section section-bg-white" id="fleet">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Comfort &amp; Reliability</span>
      <h2 class="section-title">Our Modern Vehicle Fleet</h2>
      <p class="section-desc">
        We operate an exclusive fleet of late-model, purpose-built passenger vans maintained to the highest mechanical specifications.
      </p>
    </div>

    <div class="about-grid">
      <div>
        <img src="/images/slides/slide3.svg" alt="Fleet details" style="border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">
      </div>
      <div>
        <h3 style="font-size: 1.6rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">
          Van Fleet Highlights &amp; Amenities
        </h3>
        <ul class="service-features-list" style="font-size: 1rem; gap: 1rem;">
          <li>
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <strong>Individual Three-Point Seat Belts:</strong> Certified lap-and-shoulder harnesses for every passenger seat.
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <strong>Dual High-Output Climate Control:</strong> Powerful heating and air conditioning ensures comfort in all seasonal weather.
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <strong>Electronic Child-Safety Door Locks:</strong> Controlled strictly from the driver cockpit to prevent accidental door opening.
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <strong>Daily Sanitization &amp; Air Filtration:</strong> Non-toxic medical-grade UV and disinfectant sanitization between morning and evening shifts.
          </li>
          <li>
            <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            <strong>Average Fleet Age Under 3 Years:</strong> Low-mileage, modern safety engineering including lane departure assist and emergency automated braking.
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Call to action -->
